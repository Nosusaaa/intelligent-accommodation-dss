# Optional: allow browsers opened on LAN IPs (Vite dev server) to call this API.
# Comma-separated list, no spaces unless part of URL. Merge with built-in localhost origins.
#
# Example (replace with your teammate machine IP and Vite port):
# CORS_ORIGINS=http://192.168.1.42:5173,http://10.0.0.5:5173
#
# Load before uvicorn, e.g.:
#   export CORS_ORIGINS=http://192.168.1.42:5173
#   python3 -m uvicorn main:app --reload --host 0.0.0.0 --port 8000
CORS_ORIGINS=
